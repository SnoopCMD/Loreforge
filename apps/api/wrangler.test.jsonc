{
  // Config wrangler DES TESTS (vitest-pool-workers) : identique à
  // wrangler.jsonc SANS les bindings AI et VECTORIZE — Workers AI est
  // toujours distant (connexion + facturation dès le démarrage) et
  // Vectorize n'a pas de simulateur local. Le code les traite comme
  // optionnels (src/env.ts) : sans eux, le RAG est simplement inactif.
  // À garder en phase avec wrangler.jsonc pour tout le reste.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "loreforge-api",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-06",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "loreforge-db",
      "database_id": "a54f4a9a-e4c1-43c8-87f8-1d9bd20596c6",
      "migrations_dir": "migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "CACHE",
      "id": "c62c5a6e3a44462d9219649ef9a9d6ee"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "GAME_SESSIONS",
        "class_name": "GameSession"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["GameSession"]
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "loreforge-files"
    }
  ],
  "vars": {
    "ENVIRONMENT": "development"
  },
  "observability": {
    "enabled": true
  }
}
