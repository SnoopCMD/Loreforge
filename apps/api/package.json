{
  "name": "@loreforge/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "build:check": "wrangler deploy --dry-run --outdir=dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply loreforge-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply loreforge-db --remote"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.112.1",
    "hono": "^4.8.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.18.5",
    "@cloudflare/workers-types": "^4.20250705.0",
    "typescript": "^5.8.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.23.0"
  }
}
