{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "loreforge-api",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-06",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "loreforge-db",
      // Remplacer par l'id réel après `wrangler d1 create loreforge-db`.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      // À créer côté Cloudflare : `wrangler r2 bucket create loreforge-files`.
      "bucket_name": "loreforge-files"
    }
  ],
  "vars": {
    // Passe à "production" via `wrangler deploy --var ENVIRONMENT:production`
    // ou un environnement wrangler dédié.
    "ENVIRONMENT": "development"
  },
  "observability": {
    "enabled": true
  }
}
